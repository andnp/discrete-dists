from collections.abc import Sequence

import numpy as np

class Rng:
    def __new__(cls, seed: int): ...
    def random(self, n: int) -> np.ndarray: ...
    def __getnewargs__(self) -> tuple[int]: ...
    def __getstate__(self) -> bytes: ...
    def __setstate__(self, state: bytes): ...

class SumTree:
    size: int

    def __new__(cls, *args): ...
    def __init__(self, size: int | None = None): ...
    def update(self, idxs: np.ndarray, values: np.ndarray): ...
    def update_single(self, idx: int, value: float): ...
    def scale(self, factor: float) -> None: ...
    def get_value(self, idx: int) -> float: ...
    def get_values(self, idxs: np.ndarray) -> np.ndarray: ...
    def total(self) -> float: ...
    def query(self, v: np.ndarray) -> np.ndarray: ...
    def sample(self, rng: Rng, n: int, offset: int = 0) -> np.ndarray: ...
    def stratified_sample(self, rng: Rng, n: int, offset: int = 0) -> np.ndarray: ...
    def sample_without_replacement(self, rng: Rng, n: int, offset: int = 0) -> np.ndarray: ...
    def __getstate__(self): ...
    def __setstate__(self, state): ...

def uniform_sample(rng: Rng, lo: int, hi: int, n: int) -> np.ndarray: ...
def uniform_stratified_sample(rng: Rng, lo: int, hi: int, n: int) -> np.ndarray: ...
def uniform_sample_without_replacement(rng: Rng, lo: int, hi: int, n: int) -> np.ndarray: ...

def mixture_sample(
    rng: Rng,
    parts: Sequence[tuple[str, tuple[int, int] | tuple[int, SumTree], float]],
    n: int,
) -> np.ndarray: ...
def mixture_stratified_sample(
    rng: Rng,
    parts: Sequence[tuple[str, tuple[int, int] | tuple[int, SumTree], float]],
    n: int,
) -> np.ndarray: ...
def mixture_sample_without_replacement(
    rng: Rng,
    parts: Sequence[tuple[str, tuple[int, int] | tuple[int, SumTree], float]],
    n: int,
) -> np.ndarray: ...
def mixture_probs(
    parts: Sequence[tuple[str, tuple[int, int] | tuple[int, SumTree], float]],
    elements: np.ndarray,
) -> np.ndarray: ...
